{
  "name": "personal-web",
  "version": "0.3.0",
  "description": "Personal site built with Payload CMS 4 and TanStack Start",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" payload build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation vite dev",
    "devsafe": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && cross-env NODE_OPTIONS=--no-deprecation vite dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate:db-schema": "cross-env NODE_OPTIONS=--no-deprecation payload generate:db-schema",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation srvx --prod --dir=. --static=dist/client --entry=dist/server/server.js",
    "typecheck": "tsc --noEmit",
    "paraglide": "node scripts/paraglide.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@inlang/paraglide-js": "^3.2.2",
    "@octokit/rest": "^22.0.1",
    "@payloadcms/db-postgres": "4.0.0-beta.10",
    "@payloadcms/email-resend": "4.0.0-beta.10",
    "@payloadcms/graphql": "4.0.0-beta.10",
    "@payloadcms/richtext-lexical": "4.0.0-beta.10",
    "@payloadcms/storage-s3": "4.0.0-beta.10",
    "@payloadcms/tanstack-start": "4.0.0-beta.10",
    "@payloadcms/transformer-sharp": "4.0.0-beta.10",
    "@payloadcms/ui": "4.0.0-beta.10",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.10",
    "@sindresorhus/slugify": "^3.0.0",
    "@stylexjs/stylex": "^0.19.2",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "isomorphic-dompurify": "^3.18.0",
    "payload": "4.0.0-beta.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.17.1",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "^0.19.2",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.3",
    "@vitejs/plugin-rsc": "^0.5.39",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "7.0.2000",
    "srvx": "0.11.21",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "engines": {
    "node": "^24.22.3 || >=26.13.1"
  }
}
